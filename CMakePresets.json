{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc-ninja",
      "displayName": "GCC with Ninja (Release library, Debug tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-ninja",
      "configurePreset": "gcc-ninja"
    }
  ],
  "testPresets": [
    {
      "name": "gcc-ninja",
      "configurePreset": "gcc-ninja",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
